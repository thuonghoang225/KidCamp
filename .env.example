# Bỏ trống hai biến Supabase để chạy chế độ Demo (dữ liệu lưu trong .data/ trên máy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chuỗi ngẫu nhiên ≥ 16 ký tự để ký cookie mở khóa khu phụ huynh (bắt buộc khi chạy production)
PARENT_COOKIE_SECRET=

# Giọng đọc Azure (tùy chọn) — chỉ dùng khi chạy `pnpm audio:azure` trên máy, không gửi lên trình duyệt
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Nhận diện giọng nói trên máy chủ (tùy chọn, nên bật): Whisper qua Groq, gói miễn phí đủ dùng.
# Chưa đặt thì app dùng nhận diện có sẵn của trình duyệt.
GROQ_API_KEY=
